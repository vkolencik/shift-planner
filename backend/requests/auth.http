POST https://krtek.eu.auth0.com/oauth/token
Content-Type: application/json

{
  "grant_type": "password",
  "audience": "https://b.krtek.me",
  "scope": "",
  "username": "{{testUserName}}",
  "password": "{{testUserPassword}}",
